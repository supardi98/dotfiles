MimeType=application/wps-office.et;application/wps-office.ett;application/wps-office.etso;application/wps-office.etss;application/vnd.ms-excel;application/msexcel;application/x-msexcel;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.openxmlformats-officedocument.spreadsheetml.template;application/vnd.ms-excel.template.macroEnabled.12;application/vnd.ms-excel.sheet.binary.macroEnabled.12;application/wps-office.xlsx;application/wps-office.xltx;application/wps-office.uos;
Name=WPS Spreadsheets
StartupNotify=false
Terminal=false
Type=Application
Categories=Office;Spreadsheet;Qt;
