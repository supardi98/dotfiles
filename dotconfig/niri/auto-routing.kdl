// 🗂️ Smart Window Auto-Routing Rules for Niri
// Toggle ON/OFF with Super + Shift + A (via ~/.config/niri/scripts/toggle-routing.sh)

// 💻 Workspace 1: Code & Development
window-rule {
    match app-id="code"
    match app-id="com.microsoft.VSCode"
    match app-id="antigravity"
    open-on-workspace "󰅩"
}

// 🌐 Workspace 2: Web & Research
window-rule {
    match app-id="brave-browser"
    match app-id="google-chrome"
    match app-id="firefox"
    open-on-workspace "󰖟"
}

// 💬 Workspace 3: Komunikasi & Musik
window-rule {
    match app-id="Spotify"
    match app-id="discord"
    match app-id="org.telegram.desktop"
    match app-id="Slack"
    open-on-workspace "󰓇"
}

// 📁 Workspace 4: File & Dokumen
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="wps"
    match app-id="soffice.bin"
    match app-id="libreoffice-writer"
    match app-id="libreoffice-calc"
    open-on-workspace "󰉋"
}
