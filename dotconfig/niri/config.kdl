// Niri Configuration File
// Optimized Version for Glassy Look & Fixed UX

// Screenshot settings
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-speed 0.2
    }
}

cursor {
    xcursor-theme "ArcStarry-cursors"
    xcursor-size 24
}

output "HDMI-A-1" {
    mode "2560x1440@59.951"
    scale 1.0
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    
    background-color "#00000000"

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#9ecaff" // Updated via reload.sh
        inactive-color "#1e1e2e"
    }

    struts {
        left 0
        right 0
        top 4
        bottom 0
    }
}

// Global blur settings
blur {
    passes 3
    offset 5
}

// Animations
animations {
    slowdown 0.8
}

// Named Workspaces with Glyph Icons
workspace "󰅩"
workspace "󰖟"
workspace "󰓇"
workspace "󰉋"

// Autostart applications
spawn-at-startup "noctalia"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "spotify-tray-launcher"

binds {
    Mod+Return { spawn "kitty"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Grave { spawn "~/.config/niri/scripts/scratchpad.sh" "quake"; }
    Mod+G { spawn "~/.config/niri/scripts/scratchpad.sh" "lazygit"; }
    Mod+N { spawn "~/.config/niri/scripts/scratchpad.sh" "notes"; }
    Mod+Shift+N { spawn "~/.config/niri/scripts/scratchpad.sh" "nvim"; }
    Mod+Shift+C { spawn "~/.config/niri/scripts/scratchpad.sh" "calc"; }
    Mod+Q { close-window; }
    Mod+Shift+Q { spawn "xkill"; }
    Mod+Shift+E { quit; }
    Mod+Tab { spawn "~/.config/niri/scripts/workspace-cycle.sh" "next"; }
    Mod+Shift+Tab { spawn "~/.config/niri/scripts/workspace-cycle.sh" "prev"; }
    Mod+O { toggle-overview; }
    Mod+Shift+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+M { move-column-to-monitor-next; }
    Mod+M { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Mod+S { consume-window-into-column; }
    Mod+Shift+S { expel-window-from-column; }
    
    Mod+E { spawn "nautilus"; }
    Mod+B { spawn "brave"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Period { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }
    Mod+P { spawn "kitty" "--class" "project-switcher" "--title" "Project Switcher" "-e" "/home/supardi/.config/niri/scripts/project-switcher.sh"; }
    Mod+Shift+A { spawn "~/.config/niri/scripts/toggle-routing.sh"; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Scrolling Actions
    Mod+WheelScrollDown      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-left; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { spawn "~/.config/niri/scripts/reload.sh"; }
    Mod+T { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+1 { focus-workspace "󰅩"; }
    Mod+2 { focus-workspace "󰖟"; }
    Mod+3 { focus-workspace "󰓇"; }
    Mod+4 { focus-workspace "󰉋"; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace "󰅩"; }
    Mod+Shift+2 { move-column-to-workspace "󰖟"; }
    Mod+Shift+3 { move-column-to-workspace "󰓇"; }
    Mod+Shift+4 { move-column-to-workspace "󰉋"; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    
    // Resize Actions
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-attached-panel$"
    match namespace="^noctalia-floating-panel$"
    match namespace="^noctalia-bar-.*$"
    match namespace="^noctalia-notification$"
    match namespace="^noctalia-osd$"
    background-effect {
        blur true
    }
}

// Glassy Effect for Kitty & Scratchpads
window-rule {
    match app-id=r#"^(kitty|quake|scratch-.*|project-switcher)$"#
    opacity 0.8
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Inactive window transparency & blur
window-rule {
    match is-focused=false
    opacity 0.8
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Glassy Effect for GTK Apps (Nautilus, etc)
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Loupe"
    match app-id="org.gnome.eog"
    match app-id="org.gnome.TextEditor"
    match app-id="org.gnome.Calculator"
    match app-id="org.omarchy.Omcalc"
    match app-id="Spotify"
    match app-id="code"
    match app-id="xdg-desktop-portal-gnome"
    match app-id="dev.noctalia.Noctalia"
    opacity 0.85
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Glassy Effect for Noctalia Settings (Focused)
window-rule {
    match app-id="dev.noctalia.Noctalia"
    opacity 0.85
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Float specific utility apps
window-rule {
    match app-id=r#"^(org\.gnome\.Calculator|pavucontrol|blueman-manager|nm-connection-editor|xdg-desktop-portal.*|Spotify|org\.gnome\.TextEditor)$"#
    open-floating true
}

// Picture-in-Picture (PiP) - More aggressive matching
window-rule {
    match title="Picture-in-Picture"
    match title="Picture-in-picture"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// Scratchpad (Quake Terminal)
window-rule {
    match app-id="quake"
    open-floating true
    default-floating-position x=128 y=32 relative-to="top-left"
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.4; }
    opacity 0.8
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Global Project Switcher
window-rule {
    match app-id="project-switcher"
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.60; }
    opacity 0.85
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Scratchpad Lazygit
window-rule {
    match app-id="scratch-lazygit"
    open-floating true
    default-column-width { proportion 0.85; }
    default-window-height { proportion 0.85; }
    opacity 0.90
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Scratchpad Quick Notes
window-rule {
    match app-id="scratch-notes"
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.75; }
    opacity 0.90
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Scratchpad Calculator
window-rule {
    match app-id="scratch-calc"
    open-floating true
    default-column-width { proportion 0.35; }
    default-window-height { proportion 0.45; }
    opacity 0.90
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Scratchpad Study Notes (Neovim)
window-rule {
    match app-id="scratch-nvim"
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.75; }
    opacity 0.90
    draw-border-with-background false
    background-effect {
        blur true
    }
}


// environment
environment {
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "0"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

//include "./noctalia.kdl"

// include "auto-routing.kdl"
