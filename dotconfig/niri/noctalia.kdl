layout {

    focus-ring {
        active-color   "#ffb596"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb596"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb596"
        inactive-color "#ee671f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb59680"
    }
}

recent-windows {
    highlight {
        active-color "#ffb596"
        urgent-color "#ffb4ab"
    }
}
