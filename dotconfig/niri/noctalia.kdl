layout {

    focus-ring {
        active-color   "#bec3f4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec3f4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bec3f4"
        inactive-color "#696f9b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec3f480"
    }
}

recent-windows {
    highlight {
        active-color "#bec3f4"
        urgent-color "#ffb4ab"
    }
}
