layout {

    focus-ring {
        active-color   "#adc6ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#adc6ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#adc6ff"
        inactive-color "#4d8efe"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#adc6ff80"
    }
}

recent-windows {
    highlight {
        active-color "#adc6ff"
        urgent-color "#ffb4ab"
    }
}
